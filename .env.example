# --- LLM Gateway (SPN-02) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=anthropic          # anthropic | ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- Microsoft Graph (CHN-01 / CHN-03) ---
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_app_client_id_here
AZURE_CLIENT_SECRET=your_app_client_secret_here
GRAPH_AUTH_MODE=delegated        # delegated | application

# --- Power Automate publish adapter (CHN-22) ---
POWER_AUTOMATE_FLOW_URL=your_http_triggered_flow_url_here

# --- Storage ---
DATABASE_PATH=./data/p1.db

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | production
