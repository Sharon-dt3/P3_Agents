# --- LLM Gateway (SPN-02) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=anthropic          # anthropic | ollama | bedrock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# AWS Bedrock (a third LLM_PROVIDER option): the same Claude model,
# reached through AWS's own hosted infrastructure instead of Anthropic's
# API directly. Only needed if LLM_PROVIDER=bedrock. Authenticates via
# an explicit access key/secret/region -- never AWS's ambient default
# credential chain -- so all three of these must be set together.
# BEDROCK_MODEL_ID is an AWS inference-profile ARN (from your AWS
# account's Bedrock model access page), not a plain model name.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=your_bedrock_inference_profile_arn_here

# --- Microsoft Graph (CHN-01 / CHN-03) ---
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_app_client_id_here
AZURE_CLIENT_SECRET=your_app_client_secret_here
GRAPH_AUTH_MODE=delegated        # delegated | application

# --- Power Automate publish adapter (CHN-22) ---
TEAMS_PUBLISHER_MODE=mock          # mock | power_automate
POWER_AUTOMATE_FLOW_URL=

# --- Copilot Studio connector API (CHN-25) ---
# Shared secret the FastAPI app (p1.api.copilot_studio_api) requires in
# every action request's X-API-Key header. The app refuses to serve
# any action endpoint at all if this is unset (fail closed). Whatever
# value you set here is also what you configure as the API key in the
# Power Platform custom connector's security settings.
COPILOT_STUDIO_API_KEY=

# --- Storage ---
DATABASE_PATH=./data/p1.db

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | production

# --- Teams reader adapter (CHN-03) ---
TEAMS_READER_MODE=mock          # mock | graph
GRAPH_ACCESS_TOKEN=your_graph_access_token_here
GRAPH_TEAM_ID=your_team_id_here
