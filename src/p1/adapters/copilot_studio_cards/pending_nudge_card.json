{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "Nudge pending approval", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "${summary}", "wrap": true },
    { "type": "TextBlock", "text": "Channel: ${channel_id}", "isSubtle": true, "spacing": "None" },
    { "type": "TextBlock", "text": "Created: ${created_at}", "isSubtle": true, "spacing": "None" }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Approve",
      "data": { "action": "handle_approve", "proposal_id": "${proposal_id}", "approver_id": "${current_user_id}" }
    },
    {
      "type": "Action.Submit",
      "title": "Reject",
      "data": { "action": "handle_reject", "proposal_id": "${proposal_id}", "approver_id": "${current_user_id}" }
    }
  ]
}
